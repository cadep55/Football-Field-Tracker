<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="Football Widget"
        android:supportsRtl="true"
        android:theme="@style/Theme.FootballWidget">

        <!-- Widget Provider -->
        <receiver
            android:name=".widget.FootballWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/football_widget_info" />
        </receiver>

        <!-- Config Activity (shown when widget is added) -->
        <activity
            android:name=".ui.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.FootballWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Foreground service for live game polling -->
        <service
            android:name=".data.LiveUpdateService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Restart polling after phone reboot -->
        <receiver
            android:name=".data.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
